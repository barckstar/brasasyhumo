# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# HTML crudo del sondeo de Facebook — scratch, no versionar
research/*.html

# ---- Agregados del proyecto ----

# Sistema operativo
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editores
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# Herramientas de IA y sesiones locales
.claude/settings.local.json
.claude/interaction-log.md.bak
graphify-out/
.next-docs/

# Salidas de prueba y cobertura
/test-results/
/playwright-report/
*.lcov

# Material de trabajo pesado que no pertenece al repo.
# Las fotos originales sin optimizar viven aqui; al sitio solo suben las
# versiones WebP ya recortadas de public/platos/.
research/assets/*.png
research/assets/*.jpeg
!research/assets/logo_fb_profile.jpg

# Temporales sueltos
*.bak
pagina_tmp.html

# Material crudo de Instagram: son el insumo para las fotos de las promos.
# Al sitio solo suben las versiones ya recortadas y en WebP de public/.
research/assets/instagram/

# Bitacora y config local de la herramienta: no se versiona.
# La bitacora es material de trabajo interno, no del producto.
.claude/

# Hojas de contacto que se arman para revisar un recorte a ojo. Son un paso
# intermedio de verificacion, no material del sitio ni del sondeo.
research/assets/pruebas/
